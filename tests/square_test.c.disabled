#include "square.h"

#include <assert.h>
#include <stdio.h>

static Uint32 pixel_at(SDL_Surface *surface, int x, int y) {
  const Uint8 *row = (const Uint8 *)surface->pixels + y * surface->pitch;
  return ((const Uint32 *)row)[x];
}

int main(void) {
  SDL_Surface *surface = SDL_CreateRGBSurfaceWithFormat(
    0, 640, 480, 32, SDL_PIXELFORMAT_ARGB8888);
  assert(surface != NULL);
  SDL_Renderer *renderer = SDL_CreateSoftwareRenderer(surface);
  assert(renderer != NULL);

  draw_square(renderer);

  Uint32 white = SDL_MapRGB(surface->format, 255, 255, 255);
  Uint32 black = SDL_MapRGB(surface->format, 0, 0, 0);
  assert(pixel_at(surface, 0, 0) == white);
  assert(pixel_at(surface, 260, 180) == black);
  assert(pixel_at(surface, 379, 299) == black);
  assert(pixel_at(surface, 259, 240) == white);
  assert(pixel_at(surface, 380, 240) == white);
  assert(pixel_at(surface, 320, 179) == white);
  assert(pixel_at(surface, 320, 300) == white);

  SDL_DestroyRenderer(renderer);
  SDL_FreeSurface(surface);
  puts("square: passed");
  return 0;
}
