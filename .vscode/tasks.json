{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch unit tests",
      "type": "shell",
      "command": "make watch-test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
